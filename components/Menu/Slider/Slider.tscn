[gd_scene format=3]

[ext_resource type="Script" uid="uid://cadi31yri0nsv" path="res://components/Menu/Slider/Slider.gd" id="1"]
[ext_resource type="StyleBox" path="res://components/UI/styles/Row.tres" id="2_row"]
[ext_resource type="FontFile" uid="uid://doesrguwx81i0" path="res://assets/fonts/8bitOperatorPlus-Bold.ttf" id="3_bold"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_track"]
content_margin_top = 6.0
content_margin_bottom = 6.0
bg_color = Color(1, 1, 1, 0.12)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill"]
content_margin_top = 6.0
content_margin_bottom = 6.0
bg_color = Color(1, 0.75, 0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="Slider" type="PanelContainer"]
theme_override_styles/panel = ExtResource("2_row")
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2
mouse_filter = 2

[node name="Label" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_fonts/font = ExtResource("3_bold")
theme_override_font_sizes/font_size = 32
text = "Volume"

[node name="Value" type="Label" parent="VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0, 1)
theme_override_fonts/font = ExtResource("3_bold")
theme_override_font_sizes/font_size = 28
text = "100%"

[node name="HSlider" type="HSlider" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/slider = SubResource("StyleBoxFlat_track")
theme_override_styles/grabber_area = SubResource("StyleBoxFlat_fill")
theme_override_styles/grabber_area_highlight = SubResource("StyleBoxFlat_fill")
step = 5.0

[connection signal="value_changed" from="VBox/HSlider" to="." method="_on_HSlider_value_changed"]
