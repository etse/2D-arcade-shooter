[gd_scene format=3]

[ext_resource type="Script" path="res://components/Menu/Victory/Victory.gd" id="1"]
[ext_resource type="FontFile" uid="uid://c4wkpvq38gdoq" path="res://assets/fonts/Arcade.ttf" id="2_arcade"]
[ext_resource type="FontFile" path="res://assets/fonts/8bitOperatorPlus-Regular.ttf" id="3_regular"]
[ext_resource type="PackedScene" path="res://components/UI/MenuRow/MenuRow.tscn" id="4_row"]
[ext_resource type="StyleBox" path="res://components/UI/styles/Frame.tres" id="5_frame"]
[ext_resource type="StyleBox" path="res://components/UI/styles/Hint.tres" id="6_hint"]

[node name="Victory" type="VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
theme_override_constants/separation = 20
alignment = 1
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 2
theme_override_styles/panel = ExtResource("5_frame")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0, 1)
theme_override_fonts/font = ExtResource("2_arcade")
theme_override_font_sizes/font_size = 110
text = "Victory"
horizontal_alignment = 1

[node name="Info" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.65, 1)
theme_override_fonts/font = ExtResource("3_regular")
theme_override_font_sizes/font_size = 28
text = "You defeated the invasion and finished the game.
Congratulations, pilot!"
horizontal_alignment = 1

[node name="NewGamePlus" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.9, 0.4, 1)
theme_override_fonts/font = ExtResource("3_regular")
theme_override_font_sizes/font_size = 26
text = "New Game+ starts at Level 1."
horizontal_alignment = 1

[node name="Continue" parent="Panel/Margin/VBox" instance=ExtResource("4_row")]
unique_name_in_owner = true
layout_mode = 2
title = "CONTINUE"
detail = "Play on in New Game+"

[node name="Hint" type="PanelContainer" parent="."]
layout_mode = 2
theme_override_styles/panel = ExtResource("6_hint")

[node name="Text" type="Label" parent="Hint"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.65, 1)
theme_override_fonts/font = ExtResource("3_regular")
theme_override_font_sizes/font_size = 26
text = "Enter: continue to the main menu."

[connection signal="selected" from="Panel/Margin/VBox/Continue" to="." method="_on_Continue_selected"]
